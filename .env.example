# ==========================================
# Gemini Dictation & Polish Configuration
# ==========================================

# Your Google Gemini API Key (Get one from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use for speech-to-text dictation
GEMINI_MODEL=gemini-3.5-flash-lite

# Model to use for text proofreading & correction
GEMINI_CORRECTOR_MODEL=gemini-3.5-flash-lite

# Audio Input Device: 'default' for system default microphone, or specific name like 'MacBook Pro Microphone'
# Run 'python3 main.py --list-devices' to see all detected microphones.
AUDIO_DEVICE=default

# Global Hotkey to trigger dictation ('cmd_r' for Right Command key (⌘))
HOTKEY=cmd_r

# Automatically paste transcribed text into the active window (true/false)
PASTE_AUTOMATICALLY=true

# Automatically replace selected text in-place when in editable fields (true/false)
REPLACE_SELECTED_TEXT=true

# Play subtle sound effects on record start/stop/completion (true/false)
ENABLE_SOUNDS=true

# Show minimal floating HUD overlay indicator near text caret (true/false)
ENABLE_HUD=true

# Show top panel / menu bar icon with history and controls (true/false)
ENABLE_MENUBAR=true

# HUD Glass Style: 'regular' (frosted liquid glass) or 'clear' (ultra-translucent glass)
HUD_STYLE=clear

# Comma-separated languages expected for speech recognition
DICTATION_LANGUAGES=English,Ukrainian
